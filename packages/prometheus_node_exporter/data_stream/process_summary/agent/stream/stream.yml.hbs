metricsets: ["collector"]
hosts:
{{#each hosts}}
  - {{this}}
{{/each}}
period: {{period}}
timeout: {{timeout}}
metrics_path: {{metrics_path}}
metrics_filters:
  include:
    - "node_processes_pids"
    - "node_procs_running"
    - "node_procs_blocked"
    - "node_processes_threads"
{{#if username}}
username: {{username}}
{{/if}}
{{#if password}}
password: {{password}}
{{/if}}
{{#if tags}}
tags:
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
